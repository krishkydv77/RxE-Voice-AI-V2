GROQ_API_KEY=gsk_
SARVAM_API_KEY=sk_
SERPAPI_API_KEY=6c

REDIS_URL=redis://localhost:6379/0

GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ---- TTS: Bulbul V4 Flash (V4 me persona speaker IDs: voice_language_style)
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads
SARVAM_TTS_STREAM=1
SARVAM_TTS_CODEC=mp3
SARVAM_TTS_BITRATE=64k
SARVAM_TTS_SAMPLE_RATE=22050
TTS_PREWARM=1

# ---- REAL rates (2026-11-21 verified). Apne invoice se match karke badlo
USD_INR=94
SARVAM_TTS_INR_PER_10K_CHARS=20
SARVAM_STT_INR_PER_MIN=0.49
WHISPER_USD_PER_HOUR=0.04
GROQ_RATE_IN_USD=0.05
GROQ_RATE_OUT_USD=0.08
SERPAPI_PLAN_USD=75
SERPAPI_PLAN_SEARCHES=5000
OTHER_INFRA_COST_INR=0

# ---- latency / tokens
CORE_TARGET_MS=2000
TTFT_TARGET_MS=500
LLM_TTFT_TIMEOUT_S=2
PROMPT_TOKEN_BUDGET=160
REPLY_MAX_WORDS=15
LLM_MAX_TOKENS=70
HISTORY_MSGS=2
HISTORY_MSG_CHARS=80
QUERY_LLM_WORDS=25
CONTEXT_MAX_CHARS=420
RAG_CANDIDATES=6
RETRIEVAL_CACHE_TTL=1800
ANSWER_CACHE_TTL=1800
CACHE_STATS_LOG_S=300


# ---- Cache (khaali = in-memory) ----
REDIS_URL=redis://localhost:6379/0
ANSWER_CACHE_TTL=1800
RETRIEVAL_CACHE_TTL=300
WEB_CACHE_TTL=86400
TTS_CACHE_TTL=604800

# ---- SerpAPI save rules ----
SAVE_NEAR_DUP_SCORE=0.92
SAVE_MIN_EVIDENCE_CHARS=80

# ---- MCP ----
# 1 = tools mcp_server.py ke through (pehle usse chalayein), 0 = in-process
USE_MCP=1
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# ---- Logging ----
LOG_DIR=logs
LOG_LEVEL=INFO

# ---- Server ----
HOST=0.0.0.0
PORT=8000

